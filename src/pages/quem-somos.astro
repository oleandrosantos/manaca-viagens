---
import BaseLayout from "../layouts/BaseLayout.astro";
import institucional from "../data/institucional.json";
---

<BaseLayout
  title="A Manacá"
  description="Conheça a história e a maneira de pensar viagens da Manacá."
>
  <section class="page-hero blush">
    <div class="wrap">
      <p class="eyebrow">A MANACÁ / NOSSA HISTÓRIA</p>
      <h1>
        Uma viagem pode
        <br />
        <em>abrir novos caminhos.</em>
      </h1>
      <p>
        Planejar é cuidar do caminho para que você possa estar presente em cada
        descoberta.
      </p>
    </div>
    <span class="page-flower" aria-hidden="true">
      <img
        src="/media/monograma.png"
        alt=""
        width="817"
        height="516"
        loading="lazy"
      />
    </span>
  </section>
  <section class="section wrap editorial">
    <div>
      <span class="eyebrow">NOSSO NOME</span>
      <img
        class="brand-flower"
        src="/media/flor.png"
        alt="Flor de manacá-da-serra em tons de rosa e lilás"
        loading="lazy"
      />
      <h2>
        Como a flor,
        <br />
        <em>em transformação.</em>
      </h2>
    </div>
    <div>
      {institucional.nomeTexto.map((texto) => (
        <p>{texto}</p>
      ))}
    </div>
  </section>
  <section class="about-story">
    <div class="section wrap editorial">
      <div>
        <span class="eyebrow">QUEM SOMOS</span>
        <h2>
          A história da <em>Manacá.</em>
        </h2>
      </div>
      <div>
        {institucional.historiaTexto.map((texto) => (
          <p>{texto}</p>
        ))}
      </div>
    </div>
  </section>
  <section class="founder">
    <div class="founder-art">
      <img
        src="/media/adjane.jpg"
        alt="Adjane Costa em meio à vegetação"
        loading="lazy"
      />
    </div>
    <div class="founder-copy">
      <span class="eyebrow">CONHEÇA A FUNDADORA</span>
      <h2>
        O cuidado de
        <br />
        <em>Adjane Costa.</em>
      </h2>
      {institucional.adjaneTexto.map((texto) => (
        <p>{texto}</p>
      ))}
      <a class="text-link" href="/servicos/">
        Conheça a consultoria ↗
      </a>
    </div>
  </section>
  <section class="closing wrap">
    <span class="eyebrow">VAMOS MAIS LONGE</span>
    <h2>
      Seu jeito de viajar
      <br />
      <em>é o ponto de partida.</em>
    </h2>
    <a class="button button-dark" href="/contato/">
      Contato <span>↗</span>
    </a>
  </section>
</BaseLayout>
