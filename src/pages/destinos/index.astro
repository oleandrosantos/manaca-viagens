---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Destinos"
  description="Inspire-se com a Chapada Diamantina e a Serra da Mantiqueira."
>
  <section class="page-hero blush">
    <div class="wrap">
      <p class="eyebrow">DESTINOS / INSPIRAÇÃO</p>
      <h1>
        Há lugares que
        <br />
        <em>ficam com a gente.</em>
      </h1>
      <p>
        Natureza, cultura e tempo para descobrir. Comece a imaginar por aqui.
      </p>
    </div>
  </section>
  <section class="section wrap">
    <div class="destination-grid">
      <a class="destination-card chapada" href="/destinos/chapada-diamantina/">
        <span class="destination-art" aria-hidden="true"></span>
        <span class="card-content">
          <small>BAHIA · BRASIL</small>
          <strong>
            Chapada
            <br />
            Diamantina
          </strong>
          <span>Explorar destino ↗</span>
        </span>
      </a>
      <a
        class="destination-card mantiqueira"
        href="/destinos/serra-da-mantiqueira/"
      >
        <span class="destination-art" aria-hidden="true"></span>
        <span class="card-content">
          <small>SUDESTE · BRASIL</small>
          <strong>
            Serra da
            <br />
            Mantiqueira
          </strong>
          <span>Explorar destino ↗</span>
        </span>
      </a>
    </div>
    <p class="art-note">
      Ilustrações abstratas inspiradas em paisagens brasileiras.
    </p>
  </section>
  <section class="closing wrap">
    <span class="eyebrow">O CAMINHO É SEU</span>
    <h2>
      Encontre o lugar
      <br />
      <em>que combina com você.</em>
    </h2>
    <a class="button button-dark" href="/servicos/">
      Conheça a consultoria <span>↗</span>
    </a>
  </section>
</BaseLayout>
