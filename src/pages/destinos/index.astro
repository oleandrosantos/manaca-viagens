---
import BaseLayout from "../../layouts/BaseLayout.astro";
import institucional from "../../data/institucional.json";
import { getCollection } from "astro:content";
const destinos = await getCollection("destinos", ({ data }) => !data.draft);
---

<BaseLayout
  title="Destinos"
  description="Inspire-se com a Chapada Diamantina e a Serra da Mantiqueira."
>
  <section class="page-hero blush">
    <div class="wrap">
      <p class="eyebrow">DESTINOS / INSPIRAÇÃO</p>
      <h1>
        Há lugares que
        <br />
        <em>ficam com a gente.</em>
      </h1>
      <p>{institucional.destinosTexto}</p>
    </div>
  </section>
  <section class="section wrap">
    <div class="destination-grid">
      {destinos.map((destino) => (
        <a class="destination-card" href={`/destinos/${destino.id}/`}>
          <img
            class="destination-photo"
            src={destino.data.image}
            alt=""
            loading="lazy"
          />
          <span class="card-content">
            <small>{destino.data.region}</small>
            <strong>{destino.data.title}</strong>
            <span>Explorar destino ↗</span>
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="closing wrap">
    <span class="eyebrow">O CAMINHO É SEU</span>
    <h2>
      Encontre o lugar
      <br />
      <em>que combina com você.</em>
    </h2>
    <a class="button button-dark" href="/servicos/">
      Conheça a consultoria <span>↗</span>
    </a>
  </section>
</BaseLayout>
