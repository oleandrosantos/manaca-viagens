---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página não encontrada"
  description="Esta página não foi encontrada."
>
  <section class="page-hero lavender">
    <div class="wrap">
      <p class="eyebrow">404 / CAMINHO NÃO ENCONTRADO</p>
      <h1>
        Vamos encontrar
        <br />
        <em>outro caminho?</em>
      </h1>
      <p>Esta página não está disponível.</p>
      <a class="button button-dark" href="/">
        Voltar ao início <span>↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
