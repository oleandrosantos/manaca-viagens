---
import BaseLayout from "../layouts/BaseLayout.astro";
import institucional from "../data/institucional.json";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Diário da Manacá"
  description="Histórias e inspirações para viajar com a Manacá."
>
  <section class="page-hero lavender">
    <div class="wrap">
      <p class="eyebrow">DIÁRIO DA MANACÁ</p>
      <h1>
        Histórias para
        <br />
        <em>levar com você.</em>
      </h1>
      <p>{institucional.diarioTexto}</p>
    </div>
    <span class="page-flower" aria-hidden="true">
      <img
        src="/media/monograma.png"
        alt=""
        width="817"
        height="516"
        loading="lazy"
      />
    </span>
  </section>
  {posts.length ? (
    <section class="section wrap">
      <div class="post-grid">
        {posts.map((post) => (
          <article>
            {post.data.image && (
              <img
                src={post.data.image}
                alt={post.data.imageAlt || ""}
                loading="lazy"
              />
            )}
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  ) : (
    <section class="section wrap editorial">
      <div>
        <span class="eyebrow">EM BREVE</span>
        <h2>As primeiras histórias ainda estão a caminho.</h2>
      </div>
      <div>
        <p>
          Enquanto o diário ganha forma, conheça lugares que inspiram novas
          descobertas.
        </p>
        <a class="text-link" href="/destinos/">
          Explorar destinos ↗
        </a>
      </div>
    </section>
  )}
</BaseLayout>
