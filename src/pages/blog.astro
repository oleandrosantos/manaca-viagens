---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Diário da Manacá"
  description="Histórias e inspirações para viajar com a Manacá."
>
  <section class="page-hero lavender">
    <div class="wrap">
      <p class="eyebrow">DIÁRIO DA MANACÁ</p>
      <h1>
        Histórias para
        <br />
        <em>levar com você.</em>
      </h1>
      <p>
        Um espaço para compartilhar olhares, caminhos e inspirações de viagem.
      </p>
    </div>
    <span class="page-flower" aria-hidden="true">
      ✳
    </span>
  </section>
  <section class="section wrap editorial">
    <div>
      <span class="eyebrow">EM BREVE</span>
      <h2>
        As primeiras histórias
        <br />
        <em>ainda estão a caminho.</em>
      </h2>
    </div>
    <div>
      <p>
        Enquanto o diário ganha forma, conheça lugares que inspiram novas
        descobertas.
      </p>
      <a class="text-link" href="/destinos/">
        Explorar destinos ↗
      </a>
    </div>
  </section>
</BaseLayout>
