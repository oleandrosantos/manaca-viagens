---
import BaseLayout from "../layouts/BaseLayout.astro";
import institucional from "../data/institucional.json";
---

<BaseLayout
  title="Consultoria"
  description="Entenda como a consultoria de viagens personalizadas da Manacá pode ajudar no seu planejamento."
>
  <section class="page-hero lavender">
    <div class="wrap">
      <p class="eyebrow">CONSULTORIA / VIAGENS SOB MEDIDA</p>
      <h1>
        Planejar com cuidado.
        <br />
        <em>Viajar com leveza.</em>
      </h1>
      <p>Uma jornada pensada a partir de quem você é e do que deseja viver.</p>
    </div>
    <span class="page-flower" aria-hidden="true">
      <img
        src="/media/monograma.png"
        alt=""
        width="817"
        height="516"
        loading="lazy"
      />
    </span>
  </section>
  <section class="section wrap editorial">
    <div>
      <span class="eyebrow">O QUE FAZEMOS</span>
      <h2>
        O seu tempo
        <br />
        <em>vale a viagem.</em>
      </h2>
    </div>
    <div>
      <p>{institucional.introText}</p>
    </div>
  </section>
  <section class="benefits section">
    <div class="wrap">
      <span class="eyebrow">CONSULTORIA DE VIAGENS SOB MEDIDA</span>
      <h2>
        Cuidado em cada <em>escolha.</em>
      </h2>
      <div class="benefits-grid">
        {institucional.beneficios.map((beneficio) => (
          <article>
            <h3>{beneficio.title}</h3>
            <p>{beneficio.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="process">
    <div class="wrap">
      <span class="eyebrow">JORNADA DE VIAGEM PERSONALIZADA</span>
      <h2>
        Uma jornada, <em>cinco etapas.</em>
      </h2>
      <ol class="steps">
        {institucional.jornada.map((step, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section wrap editorial">
    <div>
      <span class="eyebrow">CONSULTORIA PERSONALIZADA</span>
      <h2>
        O que está <em>incluído?</em>
      </h2>
    </div>
    <div>
      <ul>
        {institucional.incluido.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section wrap editorial">
    <div>
      <span class="eyebrow">SEU JEITO DE VIAJAR</span>
      <h2>
        Para quem é nossa <em>consultoria?</em>
      </h2>
    </div>
    <div>
      <p>A consultoria da Manacá é para quem:</p>
      <ul>
        {institucional.publico.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>
  <section class="closing wrap">
    <span class="eyebrow">COMECE A IMAGINAR</span>
    <h2>
      Qual será a sua
      <br />
      <em>próxima descoberta?</em>
    </h2>
    <a class="button button-dark" href="/contato/">
      Entre em contato <span>↗</span>
    </a>
  </section>
</BaseLayout>
