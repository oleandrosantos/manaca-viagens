---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import institucional from "../data/institucional.json";
const destinos = await getCollection("destinos", ({ data }) => !data.draft);
---

<BaseLayout
  title="Viagens no seu ritmo"
  description="Consultoria de viagens personalizadas, com cuidado em cada escolha."
>
  <section class="hero">
    <div class="hero-art" aria-hidden="true">
      <video
        class="hero-video"
        muted
        autoplay
        loop
        playsinline
        preload="none"
        poster="/media/chapada.jpeg"
        data-src="/media/video-novo-jane.mp4"
      ></video>
    </div>
    <div class="hero-content wrap">
      <p class="eyebrow light">{institucional.heroEyebrow}</p>
      <h1>{institucional.heroTitle}</h1>
      <p>{institucional.heroDescription}</p>
      <a class="button button-light" href="/servicos/">
        Conheça a consultoria <span>↗</span>
      </a>
    </div>
    <button
      class="hero-motion"
      type="button"
      aria-label="Pausar vídeo de fundo"
      title="Pausar vídeo de fundo"
      hidden
    >
      <svg
        class="icon-pause"
        viewBox="0 0 24 24"
        width="14"
        height="14"
        fill="currentColor"
        aria-hidden="true"
      >
        <rect x="6" y="4" width="3.5" height="16" rx="1"></rect>
        <rect x="14.5" y="4" width="3.5" height="16" rx="1"></rect>
      </svg>
      <svg
        class="icon-play"
        viewBox="0 0 24 24"
        width="14"
        height="14"
        fill="currentColor"
        aria-hidden="true"
        style="display: none;"
      >
        <polygon points="7,4 20,12 7,20"></polygon>
      </svg>
    </button>
  </section>
  <section class="intro wrap section">
    <div class="intro-label">
      <span class="eyebrow">OLÁ, SOMOS A MANACÁ</span>
      <span class="flower" aria-hidden="true">
        <img
          src="/media/monograma.png"
          alt=""
          width="817"
          height="516"
          loading="lazy"
        />
      </span>
    </div>
    <div>
      <h2>{institucional.introTitle}</h2>
      <div class="intro-copy">
        <p>{institucional.nomeTexto[0]}</p>
        <a class="text-link" href="/quem-somos/">
          Conheça nossa história <span>↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="approach">
    <div class="wrap approach-grid">
      <div>
        <span class="eyebrow">CONSULTORIA DE VIAGENS PERSONALIZADAS</span>
        <h2>
          Uma viagem pensada para <em>você.</em>
        </h2>
      </div>
      <div>
        <p>{institucional.introText}</p>
        <a class="text-link" href="/servicos/">
          Conheça a consultoria <span>↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section wrap destinations">
    <div class="section-head">
      <div>
        <span class="eyebrow">INSPIRAÇÃO PARA IR ALÉM</span>
        <h2>
          Lugares que convidam
          <br />
          <em>a desacelerar.</em>
        </h2>
      </div>
      <a class="text-link" href="/destinos/">
        Ver destinos ↗
      </a>
    </div>
    <p class="section-intro">{institucional.destinosTexto}</p>
    <div class="destination-grid">
      {destinos.map((destino) => (
        <a class="destination-card" href={`/destinos/${destino.id}/`}>
          <img
            class="destination-photo"
            src={destino.data.image}
            alt=""
            loading="lazy"
          />
          <span class="card-content">
            <small>{destino.data.region}</small>
            <strong>{destino.data.title}</strong>
            <span>Explorar destino ↗</span>
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="founder">
    <div class="founder-art">
      <img
        src="/media/adjane.jpg"
        alt="Adjane Costa em meio à vegetação"
        loading="lazy"
      />
    </div>
    <div class="founder-copy">
      <span class="eyebrow">POR TRÁS DA MANACÁ</span>
      <h2>
        Viajar também é<br />
        <em>se transformar.</em>
      </h2>
      <p>{institucional.adjaneTexto[0]}</p>
      <p>{institucional.adjaneTexto[1]}</p>
      <a class="text-link" href="/quem-somos/">
        A história da Manacá ↗
      </a>
    </div>
  </section>
  <section class="closing wrap">
    <span class="eyebrow">DIÁRIO DA MANACÁ</span>
    <h2>
      Ideias para <em>viajar.</em>
    </h2>
    <p class="closing-intro">{institucional.diarioTexto}</p>
    <a class="button button-dark" href="/blog/">
      Conheça o diário <span>↗</span>
    </a>
  </section>
</BaseLayout>

<script>
  const video = document.querySelector<HTMLVideoElement>(".hero-video");
  const button = document.querySelector<HTMLButtonElement>(".hero-motion");
  const iconPause = button?.querySelector<SVGElement>(".icon-pause");
  const iconPlay = button?.querySelector<SVGElement>(".icon-play");
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const setPlayingState = (isPlaying: boolean) => {
    if (!button || !iconPause || !iconPlay) return;
    if (isPlaying) {
      iconPause.style.display = "block";
      iconPlay.style.display = "none";
      button.setAttribute("aria-label", "Pausar vídeo de fundo");
      button.setAttribute("title", "Pausar vídeo de fundo");
    } else {
      iconPause.style.display = "none";
      iconPlay.style.display = "block";
      button.setAttribute("aria-label", "Reproduzir vídeo de fundo");
      button.setAttribute("title", "Reproduzir vídeo de fundo");
    }
  };

  if (video && button) {
    const updateMotion = () => {
      if (motion.matches) {
        video.pause();
        video.removeAttribute("src");
        video.load();
        button.hidden = true;
      } else if (video.dataset.src) {
        video.src = video.dataset.src;
        video
          .play()
          .then(() => {
            button.hidden = false;
            setPlayingState(true);
          })
          .catch(() => {
            button.hidden = true;
          });
      }
    };
    button.addEventListener("click", () => {
      if (video.paused) {
        video
          .play()
          .then(() => {
            setPlayingState(true);
          })
          .catch(() => {
            button.hidden = true;
          });
      } else {
        video.pause();
        setPlayingState(false);
      }
    });
    motion.addEventListener("change", updateMotion);
    updateMotion();
  }
</script>
