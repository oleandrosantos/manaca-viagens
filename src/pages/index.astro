---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import institucional from "../data/institucional.json";
const destinos = await getCollection("destinos", ({ data }) => !data.draft);
---

<BaseLayout
  title="Viagens no seu ritmo"
  description="Consultoria de viagens personalizadas, com cuidado em cada escolha."
>
  <section class="hero">
    <div class="hero-art" aria-hidden="true">
      <video
        class="hero-video"
        muted
        autoplay
        loop
        playsinline
        preload="none"
        poster="/media/chapada.jpeg"
        data-src="/media/video-novo-jane.mp4"
      ></video>
    </div>
    <div class="hero-content wrap">
      <p class="eyebrow light">{institucional.heroEyebrow}</p>
      <h1>{institucional.heroTitle}</h1>
      <p>{institucional.heroDescription}</p>
      <a class="button button-light" href="/servicos/">
        Conheça a consultoria <span>↗</span>
      </a>
    </div>
    <button class="hero-motion" type="button" hidden>
      Pause o v?deo de fundo
    </button>
  </section>
  <section class="intro wrap section">
    <div class="intro-label">
      <span class="eyebrow">OLÁ, SOMOS A MANACÁ</span>
      <span class="flower" aria-hidden="true">
        ✳
      </span>
    </div>
    <div>
      <h2>{institucional.introTitle}</h2>
      <div class="intro-copy">
        <p>{institucional.introText}</p>
        <a class="text-link" href="/quem-somos/">
          Conheça nossa história <span>↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="approach">
    <div class="wrap approach-grid">
      <div>
        <span class="eyebrow">O CUIDADO ESTÁ NOS DETALHES</span>
        <h2>
          Menos pressa.
          <br />
          <em>Mais presença.</em>
        </h2>
        <p>
          Da escolha do destino à organização do caminho, a consultoria ajuda a
          dar forma a uma viagem mais leve e pessoal.
        </p>
        <a class="text-link" href="/servicos/">
          Entenda como funciona ↗
        </a>
      </div>
      <div class="principles">
        <div>
          <span>01</span>
          <h3>Escuta</h3>
          <p>Seus interesses e seu ritmo orientam as escolhas.</p>
        </div>
        <div>
          <span>02</span>
          <h3>Curadoria</h3>
          <p>Hospedagens, trajetos e experiências pensados em conjunto.</p>
        </div>
        <div>
          <span>03</span>
          <h3>Planejamento</h3>
          <p>Uma jornada organizada para aproveitar cada momento.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section wrap destinations">
    <div class="section-head">
      <div>
        <span class="eyebrow">INSPIRAÇÃO PARA IR ALÉM</span>
        <h2>
          Lugares que convidam
          <br />
          <em>a desacelerar.</em>
        </h2>
      </div>
      <a class="text-link" href="/destinos/">
        Ver destinos ↗
      </a>
    </div>
    <div class="destination-grid">
      {destinos.map((destino) => (
        <a class="destination-card" href={`/destinos/${destino.id}/`}>
          <img
            class="destination-photo"
            src={destino.data.image}
            alt=""
            loading="lazy"
          />
          <span class="card-content">
            <small>{destino.data.region}</small>
            <strong>{destino.data.title}</strong>
            <span>Explorar destino ↗</span>
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="founder">
    <div class="founder-art">
      <img
        src="/media/adjane.jpg"
        alt="Adjane Costa em meio à vegetação"
        loading="lazy"
      />
    </div>
    <div class="founder-copy">
      <span class="eyebrow">POR TRÁS DA MANACÁ</span>
      <h2>
        Viajar também é<br />
        <em>se transformar.</em>
      </h2>
      <p>{institucional.founderText}</p>
      <a class="text-link" href="/quem-somos/">
        A história da Manacá ↗
      </a>
    </div>
  </section>
  <section class="closing wrap">
    <span class="eyebrow">O PRÓXIMO CAPÍTULO</span>
    <h2>
      Que histórias você
      <br />
      <em>quer levar na bagagem?</em>
    </h2>
    <p>Uma boa viagem começa com espaço para imaginar.</p>
    <a class="button button-dark" href="/contato/">
      Vamos conversar <span>↗</span>
    </a>
  </section>
</BaseLayout>

<script>
  const video = document.querySelector<HTMLVideoElement>(".hero-video");
  const button = document.querySelector<HTMLButtonElement>(".hero-motion");
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (video && button) {
    const updateMotion = () => {
      if (motion.matches) {
        video.pause();
        video.removeAttribute("src");
        video.load();
        button.hidden = true;
      } else if (video.dataset.src) {
        video.src = video.dataset.src;
        video
          .play()
          .then(() => {
            button.hidden = false;
            button.textContent = "Pause o v?deo de fundo";
          })
          .catch(() => {
            button.hidden = true;
          });
      }
    };
    button.addEventListener("click", () => {
      if (video.paused) {
        video
          .play()
          .then(() => {
            button.textContent = "Pause o v?deo de fundo";
          })
          .catch(() => {
            button.hidden = true;
          });
      } else {
        video.pause();
        button.textContent = "Reproduzir v?deo de fundo";
      }
    });
    motion.addEventListener("change", updateMotion);
    updateMotion();
  }
</script>
