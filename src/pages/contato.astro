---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contact, whatsappHref, emailHref } from "../lib/contact";
---

<BaseLayout
  title="Contato"
  description="Converse com a Manacá Viagens pelo WhatsApp ou e-mail e comece a planejar sua viagem personalizada."
>
  <section class="page-hero blush">
    <div class="wrap">
      <p class="eyebrow">CONTATO / COMEÇAR A CONVERSA</p>
      <h1>
        Toda viagem começa
        <br />
        <em>com uma ideia.</em>
      </h1>
      <p>Conte para nós o que você sonha viver na sua próxima jornada.</p>
      <div class="contact-hero-actions">
        <a
          class="button button-dark"
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          Falar pelo WhatsApp <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={emailHref}>
          Enviar e-mail <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <span class="page-flower" aria-hidden="true">
      ✳
    </span>
  </section>
  <section class="section wrap editorial" aria-labelledby="canais-titulo">
    <div>
      <span class="eyebrow">ESTAMOS À DISPOSIÇÃO</span>
      <h2 id="canais-titulo">
        Vamos planejar
        <br />
        <em>o próximo capítulo.</em>
      </h2>
    </div>
    <div>
      <p>
        Prefere conversar por mensagem ou por e-mail? Escolha o canal mais
        confortável para contar suas ideias, dúvidas e expectativas.
      </p>
      <div class="contact-methods">
        <a
          class="contact-method"
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="eyebrow">WHATSAPP</span>
          <strong>{contact.whatsappDisplay}</strong>
          <span class="contact-method-action">Iniciar conversa ↗</span>
        </a>
        <a class="contact-method" href={emailHref}>
          <span class="eyebrow">E-MAIL</span>
          <strong>{contact.email}</strong>
          <span class="contact-method-action">Escrever e-mail ↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
