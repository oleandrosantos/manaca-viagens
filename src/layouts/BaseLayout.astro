---
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const links = [
  { href: "/", label: "Início" },
  { href: "/quem-somos/", label: "A Manacá" },
  { href: "/servicos/", label: "Consultoria" },
  { href: "/destinos/", label: "Destinos" },
  { href: "/blog/", label: "Diário" },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Manacá Viagens</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href="/" aria-label="Manacá Viagens, início">
          <span class="brand-mark" aria-hidden="true">
            ✳
          </span>
          <span>
            manacá<small>VIAGENS</small>
          </span>
        </a>
        <nav aria-label="Navegação principal" class="desktop-nav">
          {links.map((link) => (
            <a
              href={link.href}
              aria-current={
                Astro.url.pathname === link.href ? "page" : undefined
              }
            >
              {link.label}
            </a>
          ))}
        </nav>
        <a class="header-cta" href="/contato/">
          Vamos conversar <span aria-hidden="true">↗</span>
        </a>
        <details class="mobile-menu">
          <summary>
            Menu <span aria-hidden="true">☰</span>
          </summary>
          <nav aria-label="Navegação móvel">
            {links.map((link) => (
              <a
                href={link.href}
                aria-current={
                  Astro.url.pathname === link.href ? "page" : undefined
                }
              >
                {link.label}
              </a>
            ))}
            <a href="/contato/">Contato ↗</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-grid">
        <div>
          <a class="brand footer-brand" href="/">
            <span class="brand-mark" aria-hidden="true">
              ✳
            </span>
            <span>
              manacá<small>VIAGENS</small>
            </span>
          </a>
          <p>
            Viagens pensadas com cuidado,
            <br />
            para serem vividas no seu ritmo.
          </p>
        </div>
        <div>
          <span class="eyebrow">Explore</span>
          <nav aria-label="Navegação do rodapé">
            {links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
            <a href="/contato/">Contato</a>
          </nav>
        </div>
        <div>
          <span class="eyebrow">Uma viagem começa aqui</span>
          <p>Conheça nossa forma de planejar experiências com sentido.</p>
          <a class="text-link" href="/servicos/">
            Conhecer a consultoria ↗
          </a>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>Manacá Viagens</span>
        <span>Feito para descobrir, com calma.</span>
      </div>
    </footer>
    <script>
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          const menu =
            document.querySelector<HTMLDetailsElement>(".mobile-menu[open]");
          if (menu) {
            menu.open = false;
            menu.querySelector("summary")?.focus();
          }
        }
      });
    </script>
  </body>
</html>
