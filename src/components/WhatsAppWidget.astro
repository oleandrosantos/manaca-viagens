---
import { whatsappHref } from "../lib/contact";
---

<a
  class="whatsapp-widget"
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar com a Manacá pelo WhatsApp (abre em nova aba)"
  title="Falar com a Manacá pelo WhatsApp"
>
  <span class="whatsapp-widget-label" aria-hidden="true">Fale com a gente</span>
  <span class="whatsapp-widget-icon" aria-hidden="true">
    <svg
      width="29"
      height="29"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20.5 11.6a8.5 8.5 0 0 1-12.4 7.5L3 20.6l1.5-5.1a8.5 8.5 0 1 1 16-3.9Z" />
      <path d="M8.6 8.3c.2 3.3 3 6 6.3 6.3l1.3-1.3 2 1.3-.5 1.6c-4.5 1.6-10.2-4-8.6-8.6l1.6-.5 1.3 2-1.4 1.2Z" />
    </svg>
  </span>
</a>
